{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../.",
          "files": [
            "ingot.Core/ingot.Core.csproj",
            "ingot.Example/ingot.Example.csproj",
            "ingot.Generators/ingot.Generators.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "markdownEngineProperties": {
      "alerts": {
        "SUCCESS": "alert alert-secondary"
      }
    },
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/ingot"
    ],
    "globalMetadata": {
      "_appName": "ingot",
      "_appTitle": "ingot docs",
      "_description": "A C# framework to programmatically create Minecraft Bedrock Edition packs.",
      "_enableSearch": true,
      "_appLogoPath": "./images/ingotSmall.png",
      "_appFaviconPath": "./images/ingotSmall.png",
      "_appFooter": "<span>ingot - C# framework for Minecraft Bedrock packs. Built with <a href=\"https://dotnet.github.io/docfx\">docfx</a>.</span>",
      "pdf": false
    }
  }
}